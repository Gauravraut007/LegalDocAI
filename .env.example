# =============================================================================
# Legal Document Intelligence Platform - canonical environment template
# Copy to `.env` and fill in real secrets. Never commit `.env`.
# =============================================================================

# -------------------------- Environment ---------------------------------------
ENVIRONMENT=development

# -------------------------- Postgres (shared cluster) -------------------------
POSTGRES_USER=postgres
POSTGRES_PASSWORD=Test123
POSTGRES_MULTIPLE_DATABASES=fastapi_db,django_db

# FastAPI logical database
FASTAPI_DB_NAME=fastapi_db
DATABASE_URL=postgresql+asyncpg://localhost:Test123@postgres:5432/fastapi_db
SYNC_DATABASE_URL=postgresql+psycopg2://localhost:Test123@postgres:5432/fastapi_db

# Django logical database
DJANGO_DB_NAME=django_db
DJANGO_DB_USER=postgres
DJANGO_DB_PASSWORD=Test123
DJANGO_DB_HOST=postgres
DJANGO_DB_PORT=5432

# -------------------------- Redis ---------------------------------------------
REDIS_URL=redis://redis:6379/0
CELERY_BROKER_URL=redis://redis:6379/1
CELERY_RESULT_BACKEND=redis://redis:6379/2

# -------------------------- LLM (Gemini) --------------------------------------
# ONLY external API allowed. Embeddings are LOCAL via sentence-transformers.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-1.5-flash

# -------------------------- Local embeddings (sentence-transformers) ----------
EMBEDDING_MODEL_NAME=BAAI/bge-small-en-v1.5
EMBEDDING_DIM=384

# -------------------------- FAISS ---------------------------------------------
FAISS_INDEX_DIR=/data/faiss

# -------------------------- File uploads / OCR --------------------------------
UPLOAD_DIR=/data/uploads
PROCESSED_DIR=/data/uploads/processed
MAX_UPLOAD_MB=200
ALLOWED_FILE_TYPES=pdf,docx,doc,txt,png,jpg,jpeg,tiff,bmp

# -------------------------- JWT (shared between Django & FastAPI) -------------
# Both services MUST use the same signing key + algorithm + issuer so tokens
# minted by Django can be validated by FastAPI for cross-service auth.
JWT_SIGNING_KEY=replace-me-with-a-long-random-secret
JWT_ALGORITHM=HS256
JWT_ISSUER=django-service
JWT_ACCESS_TOKEN_EXPIRE_MINUTES=15
JWT_REFRESH_TOKEN_EXPIRE_DAYS=7

# -------------------------- Django --------------------------------------------
DJANGO_SECRET_KEY=replace-me-django-secret
DJANGO_DEBUG=True
DJANGO_SETTINGS_MODULE=core.settings.development
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1,django,fastapi
DJANGO_SUPERUSER_USERNAME=admin
DJANGO_SUPERUSER_EMAIL=admin@example.com
DJANGO_SUPERUSER_PASSWORD=Admin1234!

# -------------------------- FastAPI -------------------------------------------
FASTAPI_HOST=0.0.0.0
FASTAPI_PORT=8001
FASTAPI_BASE_URL=http://fastapi:8001

# -------------------------- CORS ----------------------------------------------
CORS_ORIGINS=http://localhost:3000,http://localhost:8000,http://localhost:8001

# -------------------------- Observability -------------------------------------
SENTRY_DSN=
LOG_LEVEL=INFO

# -------------------------- Rate limiting -------------------------------------
RATE_LIMIT_PER_MINUTE=60
